FROM registry.redhat.io/rhaii-preview/vllm-cuda-rhel9:1786522102

USER 0

ENV MODEL_PATH=/models/Qwen3-4B \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY --chown=0:0 ./qwen-model ${MODEL_PATH}
RUN chmod -R g+rX ${MODEL_PATH}

USER 1001

EXPOSE 8000

ENTRYPOINT ["vllm", "serve"]
CMD ["/models/Qwen3-4B", "--host", "0.0.0.0", "--port", "8000"]
